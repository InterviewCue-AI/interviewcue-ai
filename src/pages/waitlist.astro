---
import BaseLayout from '../layouts/BaseLayout.astro';
import { isWaitlistAppsScriptConfigured, waitlistForm } from '../lib/waitlist';
---

<BaseLayout
  title="Join the InterviewCue Waitlist"
  description="Join the early access list for InterviewCue, an AI interview copilot for software and internet-industry careers."
>
  <section class="section waitlist">
    <div class="container panel">
      <div>
        <p class="eyebrow">Early access</p>
        <h1>Help shape the AI interview coach for software careers.</h1>
        <p>
          Get early access updates for live interview cues, technical mock interviews, and role-specific practice workflows.
        </p>
      </div>
      <form
        name="waitlist"
        data-ga-event="waitlist_submit"
        data-ga-category="lead"
        data-ga-label="waitlist_form"
        data-ga-section="waitlist_page"
        data-ga-component="waitlist_form"
        data-apps-script-endpoint={waitlistForm.appsScriptEndpoint}
        data-configured={String(isWaitlistAppsScriptConfigured)}
      >
        <label>
          Work email
          <input
            type="email"
            name="email"
            placeholder="you@example.com"
            required
          />
        </label>
        <label>
          Target role
          <input
            type="text"
            name="role"
            placeholder="Software Engineer"
          />
        </label>
        <label>
          Interview goal
          <input
            type="text"
            name="interviewGoal"
            placeholder="Live interview, mock practice, system design..."
          />
        </label>
        <input type="hidden" name="sourcePage" value="/waitlist/" />
        <button type="submit" data-form-submit>
          {isWaitlistAppsScriptConfigured ? 'Join waitlist' : 'Waitlist opening soon'}
        </button>
        <p class="form-status" data-form-status aria-live="polite">
          {
            isWaitlistAppsScriptConfigured
              ? 'We will use your answers to prioritize early access.'
              : 'Lead capture is being connected to Google Sheets.'
          }
        </p>
      </form>
    </div>
  </section>
  <script>
    const form = document.querySelector('form[name="waitlist"]');
    const status = document.querySelector('[data-form-status]');
    const submitButton = document.querySelector('[data-form-submit]');
    let submitTimeout;
    let activeCallbackName;

    const setStatus = (message, state) => {
      if (!status) return;
      status.textContent = message;
      status.setAttribute('data-state', state);
    };

    const setSubmitEnabled = (enabled) => {
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = !enabled;
      }
    };

    const cleanupJsonp = (script, callbackName) => {
      window.clearTimeout(submitTimeout);
      script?.remove();
      if (callbackName && window[callbackName]) {
        delete window[callbackName];
      }
      activeCallbackName = undefined;
    };

    form?.addEventListener('submit', (event) => {
      if (!(form instanceof HTMLFormElement)) return;

      event.preventDefault();

      if (form.dataset.configured !== 'true') {
        setStatus('Please check back soon. The waitlist capture is being connected.', 'error');
        return;
      }

      const endpoint = form.dataset.appsScriptEndpoint;
      if (!endpoint) {
        setStatus('Please check back soon. The waitlist capture is being connected.', 'error');
        return;
      }

      if (activeCallbackName) {
        return;
      }

      const formData = new FormData(form);
      const callbackName = `interviewCueWaitlist${Date.now()}`;
      const params = new URLSearchParams({
        callback: callbackName,
        email: String(formData.get('email') || ''),
        role: String(formData.get('role') || ''),
        interviewGoal: String(formData.get('interviewGoal') || ''),
        sourcePage: String(formData.get('sourcePage') || '/waitlist/'),
        pageLocation: window.location.href,
        userAgent: window.navigator.userAgent,
      });
      const script = document.createElement('script');

      activeCallbackName = callbackName;
      setSubmitEnabled(false);
      setStatus('Submitting your early access request...', 'pending');

      window[callbackName] = (payload) => {
        cleanupJsonp(script, callbackName);
        setSubmitEnabled(true);

        if (payload?.ok) {
          form.reset();
          setStatus('Thanks. Your early access request was submitted.', 'success');
          return;
        }

        setStatus('We could not save your request. Please try again.', 'error');
      };

      script.src = `${endpoint}?${params.toString()}`;
      script.async = true;
      script.onerror = () => {
        cleanupJsonp(script, callbackName);
        setSubmitEnabled(true);
        setStatus('We could not reach the waitlist service. Please try again.', 'error');
      };

      submitTimeout = window.setTimeout(() => {
        cleanupJsonp(script, callbackName);
        setSubmitEnabled(true);
        setStatus('We could not confirm the waitlist submission. Please try again.', 'error');
      }, 12000);

      document.body.append(script);
    });
  </script>
</BaseLayout>

<style>
  .waitlist {
    min-height: 68vh;
    display: grid;
    align-items: center;
  }

  .panel {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 40px;
    align-items: start;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 34px;
  }

  h1 {
    max-width: 740px;
    margin: 0;
    font-size: clamp(2.1rem, 4.2vw, 3.6rem);
    line-height: 1.05;
  }

  p:not(.eyebrow) {
    max-width: 620px;
    color: var(--ink-soft);
    font-size: 1.1rem;
  }

  form {
    display: grid;
    gap: 14px;
  }

  label {
    display: grid;
    gap: 7px;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 700;
  }

  input {
    min-height: 46px;
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 0 12px;
  }

  button {
    min-height: 46px;
    border: 0;
    border-radius: 7px;
    background: var(--brand);
    color: white;
    font-weight: 800;
    cursor: pointer;
  }

  button:disabled {
    cursor: progress;
    opacity: 0.72;
  }

  .form-status {
    margin: 2px 0 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-muted);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 720;
    line-height: 1.45;
    padding: 10px 12px;
  }

  .form-status[data-state='pending'] {
    border-color: rgba(37, 99, 235, 0.24);
    background: rgba(37, 99, 235, 0.08);
    color: #1d4ed8;
  }

  .form-status[data-state='success'] {
    border-color: rgba(13, 148, 136, 0.26);
    background: rgba(13, 148, 136, 0.1);
    color: #0f766e;
  }

  .form-status[data-state='error'] {
    border-color: rgba(220, 38, 38, 0.22);
    background: rgba(220, 38, 38, 0.08);
    color: #b91c1c;
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }
</style>
