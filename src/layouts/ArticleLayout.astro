---
import BaseLayout from './BaseLayout.astro';
import { site } from '../lib/site';

const { title, description, publishDate, updatedDate, tags = [], ogImage, imageAlt } = Astro.props;
---

<BaseLayout title={title} description={description} image={ogImage} type="article">
  <section class="article-hero">
    <div class="container prose">
      <p class="eyebrow">Interview Resource</p>
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="meta">
        <span>{new Date(publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
        {updatedDate && <span>Updated {new Date(updatedDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>}
      </div>
      <div class="tags">
        {tags.map((tag: string) => <span>{tag}</span>)}
      </div>
      {
        ogImage && (
          <figure class="article-image">
            <img src={ogImage} alt={imageAlt || title} loading="eager" decoding="async" />
          </figure>
        )
      }
    </div>
  </section>
  <section class="article-body">
    <article class="container prose">
      <slot />
    </article>
  </section>
  <section class="section tight">
    <div class="container article-cta">
      <h2>Practice with role-specific AI coaching</h2>
      <p>{site.name} helps software candidates prepare for coding, system design, and behavioral rounds with structured feedback.</p>
      <a
        href="/ai-mock-interview/"
        data-ga-event="cta_click"
        data-ga-category="cta"
        data-ga-label="article_bottom_explore_mock_interviews"
        data-ga-section="article_bottom_cta"
        data-ga-component="article_cta"
        data-ga-variant="primary"
      >
        Explore mock interviews
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .article-hero {
    padding: 76px 0 36px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .article-hero h1 {
    margin: 0;
  }

  .meta,
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  .tags span {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 10px;
    background: var(--surface-muted);
    color: var(--ink-soft);
  }

  .article-image {
    margin: 30px 0 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-muted);
    aspect-ratio: 16 / 9;
  }

  .article-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-body {
    padding: 48px 0 18px;
  }

  .article-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 28px;
  }

  .article-cta h2 {
    margin: 0;
    font-size: 1.45rem;
  }

  .article-cta p {
    margin: 8px 0 0;
    color: var(--ink-soft);
  }

  .article-cta a {
    flex: 0 0 auto;
    border-radius: 7px;
    background: var(--brand);
    color: white;
    font-weight: 760;
    padding: 12px 16px;
  }

  @media (max-width: 760px) {
    .article-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
